TODO_PUBLIC_URL=https://todo.example.com
TODO_ADMIN_TOKEN=replace-with-at-least-32-random-characters
TODO_ENCRYPTION_KEY=replace-with-64-random-hexadecimal-characters
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_TENANT=common
TODO_SYNC_INTERVAL_SECS=60
TODO_OAUTH_ISSUER=https://auth.example.com/auth/v1
TODO_OAUTH_JWKS_URL=https://auth.example.com/auth/v1/oidc/certs
TODO_OAUTH_AUDIENCE=https://todo.example.com/mcp
TODO_OAUTH_SCOPE=todo:mcp
TODO_OAUTH_OWNER_SUBJECT=replace-with-your-identity-provider-subject
# Only for local development, with loopback bind and public URL:
# TODO_DEV_MCP_TOKEN=use-a-distinct-random-token-at-least-32-characters
